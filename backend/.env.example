# 后端环境变量配置（开发环境）
# 生产环境请在 docker-compose.yml 中配置

# 数据库连接（开发默认 SQLite，生产切 MySQL）
DATABASE_URL=sqlite:///./ip_system.db

# 管理员账号（登录时邮箱可填 admin，会映射到 ADMIN_EMAIL）
ADMIN_EMAIL=admin@seaai.com.cn
ADMIN_PASSWORD=admin123
# 生产数据库连接串请在部署环境中注入，不要提交真实账号和密码。

# CORS 允许来源，多个来源用逗号分隔
BACKEND_CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000,http://localhost:5173,http://127.0.0.1:5173

# 微信公众号 AppSecret 加密种子。生产环境必须设置为稳定随机值，变更后已保存的公众号密钥将无法解密。
WECHAT_CREDENTIAL_KEY=change-me-to-a-random-secret

# AI 服务商配置（首选 4sapi）
AI_PRIMARY_API_KEY=your-4sapi-key-here
AI_PRIMARY_BASE_URL=https://4sapi.com/v1
# 可选：指定一个模型，或用逗号指定降级链。未配置时使用后端默认模型链。
# AI_PRIMARY_MODEL=moonshotai/kimi-k2.6
# AI_PRIMARY_MODELS=moonshotai/kimi-k2.6,minimaxai/minimax-m2.7,meta/llama-3.3-70b-instruct

# AI 服务商配置（备选 OpenRouter）
AI_FALLBACK_API_KEY=your-openrouter-key-here
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# AI_FALLBACK_MODEL=openai/gpt-4o-mini
# AI_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet

# 门户配置 API（如果对接 SCRM 系统）
# PORTAL_CONFIG_API=http://portal-backend:8000/api/ai/internal/config

# ─────────── video_engine（Pixelle-Video）配置 ───────────
# 引擎根目录：workflows / templates / bgm / resources / data / output / config.yaml
# 默认由 backend/video_engine/__init__.py 自动指向 backend/video_engine/。
# 仅在容器内需要重定向到挂载卷时再覆盖此变量。
# PIXELLE_VIDEO_ROOT=/app/backend/video_engine

# Pixelle 自身使用 backend/video_engine/config.yaml（参考同目录 config.example.yaml）：
#   - LLM（视频标题/分镜/视觉提示规划专用模型，必须独立于上方 AI_PRIMARY_*）
#   - ComfyUI / RunningHub API Key（图像/视频/TTS 工作流）
#   - 默认模板与提示词前缀
# 首次启动前请：cp backend/video_engine/config.example.yaml backend/video_engine/config.yaml
# 并填写 runninghub_api_key（当前方案 C 采用 RunningHub 云路线）。

# 可选：也可以用环境变量配置视频生成专用大模型（优先级高于 config.yaml 的 llm）
# 注意：不要复用 AI_PRIMARY_*，视频生成 API Key / 模型通常和普通内容生成不同。
# VIDEO_LLM_API_KEY=your-video-llm-key-here
# VIDEO_LLM_BASE_URL=https://your-video-llm-provider.example/v1
# VIDEO_LLM_MODEL=your-video-planning-model
