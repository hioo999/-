PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8100
PLATFORM_DB=services/platform-api/data/platform.db
PLATFORM_POSTGRES_PASSWORD=replace-with-platform-postgres-password
PLATFORM_DATABASE_URL=postgresql://platform:replace-with-platform-postgres-password@localhost:5432/platform_control
PLATFORM_JWT_SECRET=replace-with-platform-jwt-secret
PLATFORM_LICENSE_SECRET=replace-with-platform-license-secret
PLATFORM_ALLOWED_HEALTH_FIELDS=tenant_id,agent_id,agent_version,status,last_heartbeat,task_pending_count,task_running_count,task_failed_count,error_code,cpu_usage,memory_usage,disk_usage
PLATFORM_LOG_LEVEL=INFO
