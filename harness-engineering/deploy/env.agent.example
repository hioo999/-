AGENT_ID=ag_local_001
AGENT_RUNTIME=stdlib
AGENT_HOST=127.0.0.1
AGENT_PORT=8200
AGENT_FASTAPI_PORT=8201
AGENT_DATA_DIR=services/agent-api/data
AGENT_STORAGE_DIR=services/agent-api/data/storage
AGENT_DB=services/agent-api/data/agent.db
AGENT_PLATFORM_BASE_URL=http://127.0.0.1:8100

# Local admin and secret material. Generate strong values before production use.
AGENT_ADMIN_PASSWORD=replace-with-strong-local-admin-password
AGENT_SECRET_KEY=replace-with-local-generated-secret-key
AGENT_SESSION_TTL_SECONDS=86400

# Local processing boundaries.
AGENT_ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.png,.jpg,.jpeg,.txt,.md,.csv
AGENT_MAX_UPLOAD_SIZE_MB=100
AGENT_ALLOWED_DATA_ROOTS=/data/cases,/Users/shared/cases
AGENT_FORBIDDEN_DATA_ROOTS=/etc,/private/etc,/System,/bin,/sbin,/usr/bin,/usr/sbin,/var/root,/root
AGENT_FORBIDDEN_PATH_PARTS=.ssh,.gnupg,.aws,.kube

# Optional local OCR command. Keep command executable in the allowed list.
AGENT_OCR_COMMAND=
AGENT_OCR_ALLOWED_COMMANDS=tesseract,paddleocr,python3
AGENT_OCR_TIMEOUT_SECONDS=30

# Lawyer-side model endpoint. Must be localhost, private IP, link-local, or .local.
AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=15

# Optional enterprise directory integrations. Secrets are saved encrypted in the local Agent DB.
AGENT_EXTERNAL_ORG_SYNC_INTERVAL_SECONDS=3600
AGENT_EXTERNAL_ORG_SYNC_BATCH_SIZE=100
AGENT_EXTERNAL_ORG_CALLBACK_BASE_URL=http://127.0.0.1:8201
AGENT_WECOM_CORP_ID=
AGENT_WECOM_AGENT_ID=
AGENT_WECOM_SECRET=
AGENT_WECOM_TOKEN=
AGENT_WECOM_AES_KEY=
AGENT_DINGTALK_CORP_ID=
AGENT_DINGTALK_APP_KEY=
AGENT_DINGTALK_APP_SECRET=
AGENT_DINGTALK_AES_KEY=
AGENT_FEISHU_APP_ID=
AGENT_FEISHU_APP_SECRET=
AGENT_FEISHU_VERIFICATION_TOKEN=
AGENT_FEISHU_ENCRYPT_KEY=

# Default enterprise assistant behavior.
AGENT_AI_ASSISTANT_DEFAULT_NAME=律所知识库助手
AGENT_AI_ASSISTANT_FEEDBACK_RETENTION_DAYS=365

# Optional Qdrant. Must be localhost, private IP, link-local, or .local.
AGENT_QDRANT_URL=http://127.0.0.1:6333
AGENT_QDRANT_COLLECTION=case_chunks
AGENT_QDRANT_TIMEOUT_SECONDS=5

# Worker loop.
AGENT_WORKER_BATCH_SIZE=20
AGENT_WORKER_SLEEP_SECONDS=5
AGENT_WORKER_MAX_RETRIES=3

# Future migration targets retained for deployment planning.
AGENT_POSTGRES_PASSWORD=replace-with-agent-postgres-password
AGENT_LOCAL_DATABASE_URL=postgresql://agent:replace-with-agent-postgres-password@localhost:5432/agent_local
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_LOG_LEVEL=INFO
