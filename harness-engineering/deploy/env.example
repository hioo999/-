PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8100
PLATFORM_DB=services/platform-api/data/platform.db
PLATFORM_POSTGRES_PASSWORD=replace-with-platform-postgres-password
PLATFORM_DATABASE_URL=postgresql://platform:replace-with-platform-postgres-password@localhost:5432/platform_control
PLATFORM_LOG_LEVEL=INFO
AGENT_HOST=127.0.0.1
AGENT_PORT=8200
AGENT_DATA_DIR=services/agent-api/data
AGENT_PLATFORM_BASE_URL=http://127.0.0.1:8100
AGENT_POSTGRES_PASSWORD=replace-with-agent-postgres-password
AGENT_LOCAL_DATABASE_URL=postgresql://agent:replace-with-agent-postgres-password@localhost:5432/agent_local
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_VECTOR_DATABASE_URL=http://localhost:6333
AGENT_LOCAL_STORAGE_ROOT=services/agent-api/data/storage
AGENT_ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.png,.jpg,.jpeg,.txt
AGENT_MAX_UPLOAD_SIZE_MB=100
